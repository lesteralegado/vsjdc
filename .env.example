# Copy to .env.local. Only browser-safe configuration belongs here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only for the dedicated development demo, never production.
VITE_DEMO_DATA=false
VITE_DEMO_APPOINTMENT_DATE=

# Enable only after the appointment API and scheduling configuration are ready.
VITE_BOOKING_ENABLED=false

# Public widget key only. TURNSTILE_SECRET_KEY belongs in Supabase secrets.
VITE_TURNSTILE_SITE_KEY=
